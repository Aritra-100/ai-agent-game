
"""Unit tests. Run from the project root:  python -m unittest discover -s tests -v"""

import os
import sys
import unittest

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))

from game import TicTacToe
from heuristic import h1_line_threat, h2_positional
from minimax import MinimaxSearch
from agents import make_nexus, make_titan
from experiment import Experiment, _reachable_positions


class TestGame(unittest.TestCase):
    def test_empty_board(self):
        g = TicTacToe()
        self.assertEqual(len(g.get_valid_moves()), 9)
        self.assertFalse(g.is_terminal())

    def test_make_move_and_errors(self):
        g = TicTacToe()
        g.make_move((1, 1), "X")
        self.assertEqual(g.board[1][1], "X")
        with self.assertRaises(ValueError):
            g.make_move((1, 1), "O")
        with self.assertRaises(ValueError):
            g.make_move((3, 0), "O")

    def test_all_eight_wins(self):
        from game import WIN_LINES
        for line in WIN_LINES:
            g = TicTacToe()
            for cell in line:
                g.make_move(cell, "O")
            self.assertEqual(g.check_winner(), "O")
            self.assertTrue(g.is_terminal())

    def test_draw(self):
        g = TicTacToe([["X", "O", "X"], ["X", "O", "O"], ["O", "X", "X"]])
        self.assertIsNone(g.check_winner())
        self.assertTrue(g.is_draw())
        self.assertTrue(g.is_terminal())

    def test_undo(self):
        g = TicTacToe()
        g.make_move((0, 0), "X")
        g.undo_move((0, 0))
        self.assertEqual(g.board, TicTacToe().board)


class TestHeuristic(unittest.TestCase):
    def test_symmetry_and_threat(self):
        b = [["X", "X", ""], ["", "O", ""], ["", "", ""]]
        for h in (h1_line_threat, h2_positional):
            self.assertGreater(h(b, "X"), h(b, "O"))
            self.assertLess(abs(h(b, "X")), 100)


class TestSearch(unittest.TestCase):
    def test_takes_immediate_win(self):
        g = TicTacToe([["X", "X", ""], ["O", "O", ""], ["", "", ""]])
        for use_ab in (True, False):
            moves, score = MinimaxSearch(h1_line_threat, use_ab).search(g, "X", 1)
            self.assertEqual(moves, [(0, 2)])
            self.assertEqual(score, 100)

    def test_blocks_threat(self):
        g = TicTacToe([["O", "O", ""], ["", "X", ""], ["", "", ""]])
        moves, _ = MinimaxSearch(h1_line_threat, True).search(g, "X", 2)
        self.assertEqual(moves, [(0, 2)])

    def test_alpha_beta_matches_minimax(self):
        """Alpha-Beta must give the same decision (best-move set and score)."""
        for g, player in _reachable_positions(4):
            for depth in (1, 2, 3, 9):
                for h in (h1_line_threat, h2_positional):
                    a = MinimaxSearch(h, False).search(g.copy(), player, depth)
                    b = MinimaxSearch(h, True).search(g.copy(), player, depth)
                    self.assertEqual(set(a[0]), set(b[0]))
                    self.assertEqual(a[1], b[1])

    def test_alpha_beta_prunes(self):
        plain = MinimaxSearch(h1_line_threat, False)
        ab = MinimaxSearch(h1_line_threat, True)
        plain.search(TicTacToe(), "X", 5)
        ab.search(TicTacToe(), "X", 5)
        self.assertLess(ab.stats.nodes_evaluated, plain.stats.nodes_evaluated)
        self.assertGreater(ab.stats.nodes_pruned, 0)
        self.assertEqual(plain.stats.nodes_pruned, 0)

    def test_depth_is_a_parameter(self):
        s = MinimaxSearch(h1_line_threat, True)
        counts = []
        for d in (1, 2, 3):
            s.search(TicTacToe(), "X", d)
            counts.append(s.stats.nodes_evaluated)
        self.assertEqual(counts, sorted(counts))
        self.assertEqual(len(set(counts)), 3)


class TestBattle(unittest.TestCase):
    def test_full_depth_never_loses(self):
        """A depth-9 agent can never lose Tic-Tac-Toe."""
        for first_idx in (0, 1):
            a, b = make_nexus(9, seed=1), make_titan(9, seed=2)
            exp = Experiment(a, b)
            rows = exp.run_multiple_games(4)
            self.assertTrue(all(r["winner"] == "DRAW" for r in rows))

    def test_alternating_start(self):
        exp = Experiment(make_nexus(2, seed=1), make_titan(2, seed=2))
        rows = exp.run_multiple_games(4)
        self.assertEqual([r["first"] for r in rows], ["NEXUS", "TITAN", "NEXUS", "TITAN"])


